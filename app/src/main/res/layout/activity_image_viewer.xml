<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
     xmlns:android="http://schemas.android.com/apk/res/android"
     xmlns:app="http://schemas.android.com/apk/res-auto"
     android:layout_height="match_parent"
     android:layout_width="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
         android:layout_height="match_parent"
         android:layout_width="match_parent"
         android:id="@+id/contentArea">

        <ImageView
             android:layout_height="0dp"
             android:layout_width="0dp"
             android:scaleType="centerCrop"
             android:contentDescription="@null"
             app:layout_constraintTop_toTopOf="parent"
             app:layout_constraintStart_toStartOf="parent"
             app:layout_constraintEnd_toEndOf="parent"
             app:layout_constraintBottom_toBottomOf="parent"
             android:id="@+id/ivBlurBg" />

        <View
             android:layout_height="0dp"
             android:layout_width="0dp"
             android:background="@null"
             app:layout_constraintTop_toTopOf="parent"
             app:layout_constraintStart_toStartOf="parent"
             app:layout_constraintEnd_toEndOf="parent"
             app:layout_constraintBottom_toBottomOf="parent" />

        <androidx.viewpager2.widget.ViewPager2
             android:layout_height="0dp"
             android:layout_width="0dp"
             app:layout_constraintTop_toTopOf="parent"
             app:layout_constraintStart_toStartOf="parent"
             app:layout_constraintEnd_toEndOf="parent"
             app:layout_constraintBottom_toBottomOf="parent"
             android:id="@+id/viewPager" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
         android:layout_height="wrap_content"
         android:layout_width="match_parent"
         android:paddingEnd="16dp"
         android:gravity="center_vertical"
         android:orientation="horizontal"
         android:paddingBottom="12dp"
         android:paddingStart="16dp"
         android:layout_gravity="top"
         android:id="@+id/topBar">

        <ir.hanzodev1375.components.sheet.customitemsheet.ui.GlassCompat
             android:layout_height="52dp"
             android:layout_width="52dp"
             app:aberrationIntensity="2"
             app:cornerRadius="26dp"
             app:saturation="140"
             android:layout_marginStart="10dp"
             app:blurAmount="0.0625"
             android:id="@+id/tvCounterg">

            <LinearLayout
                 android:layout_height="match_parent"
                 android:layout_width="match_parent"
                 android:orientation="vertical">

                <TextView
                     android:layout_height="match_parent"
                     android:layout_width="match_parent"
                     android:gravity="center"
                     android:textSize="15sp"
                     android:fontFamily="sans-serif-medium"
                     android:textColor="#FFFFFF"
                     android:id="@+id/tvCounter"
                     android:text="1·1"
                     android:textStyle="bold" />

            </LinearLayout>

        </ir.hanzodev1375.components.sheet.customitemsheet.ui.GlassCompat>

        <ir.hanzodev1375.components.sheet.customitemsheet.ui.GlassCompat
             android:layout_height="52dp"
             android:layout_width="52dp"
             app:aberrationIntensity="2"
             app:cornerRadius="26dp"
             app:saturation="140"
             android:layout_marginStart="10dp"
             app:blurAmount="0.0625"
             android:id="@+id/btnSettingsg">

            <ImageButton
                 android:layout_height="match_parent"
                 android:layout_width="match_parent"
                 android:src="@drawable/ic_settings"
                 android:contentDescription="Settings"
                 android:background="@android:color/transparent"
                 android:padding="14dp"
                 android:tint="#FFFFFF"
                 android:id="@+id/btnSettings" />

        </ir.hanzodev1375.components.sheet.customitemsheet.ui.GlassCompat>

        <ir.hanzodev1375.components.sheet.customitemsheet.ui.GlassCompat
             android:layout_height="52dp"
             android:layout_width="52dp"
             app:aberrationIntensity="2"
             app:cornerRadius="26dp"
             app:saturation="140"
             android:layout_marginStart="10dp"
             app:blurAmount="0.0625"
             android:id="@+id/btnGalleryg">

            <ImageButton
                 android:layout_height="match_parent"
                 android:layout_width="match_parent"
                 android:src="@drawable/ic_photo"
                 android:contentDescription="Gallery"
                 android:background="@android:color/transparent"
                 android:padding="14dp"
                 android:tint="#FFFFFF"
                 android:id="@+id/btnGallery" />

        </ir.hanzodev1375.components.sheet.customitemsheet.ui.GlassCompat>

        <View
             android:layout_height="1dp"
             android:layout_width="0dp"
             android:layout_weight="1" />

        <ir.hanzodev1375.components.sheet.customitemsheet.ui.GlassCompat
             android:layout_height="52dp"
             android:layout_width="52dp"
             app:aberrationIntensity="2"
             app:cornerRadius="25dp"
             app:saturation="140"
             app:blurAmount="0.0625"
             android:id="@+id/btnNextg">

            <ImageButton
                 android:layout_height="match_parent"
                 android:layout_width="match_parent"
                 android:src="@drawable/ic_arrow_forward"
                 android:contentDescription="Next"
                 android:background="@android:color/transparent"
                 android:padding="14dp"
                 android:tint="#FFFFFF"
                 android:id="@+id/btnNext" />

        </ir.hanzodev1375.components.sheet.customitemsheet.ui.GlassCompat>

    </LinearLayout>

    <LinearLayout
         android:layout_height="wrap_content"
         android:layout_width="wrap_content"
         android:gravity="center"
         android:background="@null"
         android:orientation="horizontal"
         android:layout_gravity="bottom|center_horizontal"
         android:id="@+id/bottomBar">

        <ir.hanzodev1375.components.sheet.customitemsheet.ui.GlassCompat
             android:layout_height="52dp"
             android:layout_width="52dp"
             app:aberrationIntensity="2"
             app:cornerRadius="26dp"
             app:saturation="140"
             app:blurAmount="0.0625"
             android:id="@+id/btnInfog">

            <ImageButton
                 android:layout_height="match_parent"
                 android:layout_width="match_parent"
                 android:src="@drawable/ic_info"
                 android:contentDescription="Info"
                 android:background="@android:color/transparent"
                 android:padding="14dp"
                 android:tint="#FFFFFF"
                 android:id="@+id/btnInfo" />

        </ir.hanzodev1375.components.sheet.customitemsheet.ui.GlassCompat>

        <ir.hanzodev1375.components.sheet.customitemsheet.ui.GlassCompat
             android:layout_height="52dp"
             android:layout_width="52dp"
             app:aberrationIntensity="2"
             app:cornerRadius="26dp"
             app:saturation="140"
             android:layout_marginStart="14dp"
             app:blurAmount="0.0625"
             android:id="@+id/btnRotateg">

            <ImageButton
                 android:layout_height="match_parent"
                 android:layout_width="match_parent"
                 android:src="@drawable/ic_rotate"
                 android:contentDescription="Rotate"
                 android:background="@android:color/transparent"
                 android:padding="14dp"
                 android:tint="#FFFFFF"
                 android:id="@+id/btnRotate" />

        </ir.hanzodev1375.components.sheet.customitemsheet.ui.GlassCompat>

        <ir.hanzodev1375.components.sheet.customitemsheet.ui.GlassCompat
             android:layout_height="52dp"
             android:layout_width="52dp"
             app:aberrationIntensity="2"
             app:cornerRadius="26dp"
             app:saturation="140"
             android:layout_marginStart="14dp"
             app:blurAmount="0.0625"
             android:id="@+id/btnZoomg">

            <ImageButton
                 android:layout_height="match_parent"
                 android:layout_width="match_parent"
                 android:src="@drawable/ic_zoom"
                 android:contentDescription="Zoom"
                 android:background="@android:color/transparent"
                 android:padding="14dp"
                 android:tint="#FFFFFF"
                 android:id="@+id/btnZoom" />

        </ir.hanzodev1375.components.sheet.customitemsheet.ui.GlassCompat>

        <ir.hanzodev1375.components.sheet.customitemsheet.ui.GlassCompat
             android:layout_height="52dp"
             android:layout_width="52dp"
             app:aberrationIntensity="2"
             app:cornerRadius="26dp"
             app:saturation="140"
             android:layout_marginStart="14dp"
             app:blurAmount="0.0625"
             android:id="@+id/btnSaveg">

            <ImageButton
                 android:layout_height="match_parent"
                 android:layout_width="match_parent"
                 android:src="@drawable/ic_save"
                 android:contentDescription="Save"
                 android:background="@android:color/transparent"
                 android:padding="14dp"
                 android:tint="#FFFFFF"
                 android:id="@+id/btnSave" />

        </ir.hanzodev1375.components.sheet.customitemsheet.ui.GlassCompat>

        <ir.hanzodev1375.components.sheet.customitemsheet.ui.GlassCompat
             android:layout_height="52dp"
             android:layout_width="52dp"
             app:aberrationIntensity="2"
             app:cornerRadius="26dp"
             app:saturation="140"
             android:layout_marginStart="14dp"
             app:blurAmount="0.0625"
             android:id="@+id/btnShareg">

            <ImageButton
                 android:layout_height="match_parent"
                 android:layout_width="match_parent"
                 android:src="@drawable/ic_share"
                 android:contentDescription="Share"
                 android:background="@android:color/transparent"
                 android:padding="14dp"
                 android:tint="#FFFFFF"
                 android:id="@+id/btnShare" />

        </ir.hanzodev1375.components.sheet.customitemsheet.ui.GlassCompat>

    </LinearLayout>

</FrameLayout>