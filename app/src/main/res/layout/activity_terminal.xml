<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="false">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:title="@string/terminal_title" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:background="?attr/colorSurfaceContainer">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/sessionTabs"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:orientation="horizontal" />

        <ImageButton
            android:id="@+id/btnNewSession"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackground"
            android:contentDescription="@string/terminal_new_session"
            android:padding="8dp"
            android:src="@android:drawable/ic_input_add"
            app:tint="?attr/colorOnSurface" />
    </LinearLayout>

    <com.termux.view.TerminalView
        android:id="@+id/terminalView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#000000" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="?attr/colorSurfaceContainer"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <Button
                android:id="@+id/keyEsc"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:minWidth="52dp"
                android:text="ESC" />

            <Button
                android:id="@+id/keyTab"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:minWidth="52dp"
                android:text="TAB" />

            <ToggleButton
                android:id="@+id/keyCtrl"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:minWidth="52dp"
                android:textOn="CTRL"
                android:textOff="CTRL" />

            <ToggleButton
                android:id="@+id/keyAlt"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:minWidth="52dp"
                android:textOn="ALT"
                android:textOff="ALT" />

            <Button
                android:id="@+id/keyUp"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:minWidth="48dp"
                android:text="↑" />

            <Button
                android:id="@+id/keyDown"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:minWidth="48dp"
                android:text="↓" />

            <Button
                android:id="@+id/keyLeft"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:minWidth="48dp"
                android:text="←" />

            <Button
                android:id="@+id/keyRight"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:minWidth="48dp"
                android:text="→" />

            <Button
                android:id="@+id/keySlash"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:minWidth="44dp"
                android:text="/" />

            <Button
                android:id="@+id/keyDash"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:minWidth="44dp"
                android:text="-" />

            <Button
                android:id="@+id/keyPipe"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:minWidth="44dp"
                android:text="|" />

        </LinearLayout>
    </HorizontalScrollView>

</LinearLayout>
