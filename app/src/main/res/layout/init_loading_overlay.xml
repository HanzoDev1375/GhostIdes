<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/initOverlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E6101010"
    android:clickable="true"
    android:focusable="true"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_gravity="center"
            android:src="@drawable/atomicghost"
            android:scaleType="fitCenter"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Ghost IDE"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/initOverlayVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="v1.1.5"
            android:textColor="#B0FFFFFF"
            android:textSize="13sp"
            android:letterSpacing="0.08"
            android:layout_marginBottom="32dp" />

        <ProgressBar
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:indeterminateTint="#7C4DFF"
            android:layout_marginBottom="24dp" />

        <TextView
            android:id="@+id/initOverlayStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Setting up environment..."
            android:textColor="#90FFFFFF"
            android:textSize="13sp"
            android:textAlignment="center" />

    </LinearLayout>

</FrameLayout>
