<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
     xmlns:android="http://schemas.android.com/apk/res/android"
     xmlns:app="http://schemas.android.com/apk/res-auto"
     xmlns:tools="http://schemas.android.com/tools"
     android:layout_height="wrap_content"
     android:layout_width="match_parent"
     android:background="?attr/colorSurfaceContainerLow"
     android:orientation="vertical"
     android:paddingBottom="24dp">

    <View
         android:layout_height="4dp"
         android:layout_width="32dp"
         android:layout_marginBottom="16dp"
         android:background="@drawable/music_drag_handle"
         android:layout_marginTop="12dp"
         android:layout_gravity="center_horizontal" />

    <com.google.android.material.card.MaterialCardView
         android:layout_height="260dp"
         android:layout_width="260dp"
         app:cardElevation="8dp"
         app:strokeWidth="0dp"
         app:cardCornerRadius="@dimen/music_bottom_sheet_cover_radius"
         android:layout_gravity="center_horizontal">

        <ImageView
             android:layout_height="match_parent"
             android:layout_width="match_parent"
             android:scaleType="centerCrop"
             android:contentDescription="@string/music_preview_cover"
             android:id="@+id/musicSheetCover" />

    </com.google.android.material.card.MaterialCardView>

    <TextView
         android:layout_height="wrap_content"
         android:layout_width="match_parent"
         android:layout_marginEnd="36dp"
         android:ellipsize="end"
         android:textSize="22sp"
         android:textColor="?attr/colorOnSurface"
         android:singleLine="true"
         android:layout_marginTop="24dp"
         android:layout_marginStart="36dp"
         tools:text="Song Name"
         android:gravity="center"
         android:id="@+id/musicSheetTitle"
         android:textStyle="bold" />

    <TextView
         android:layout_height="wrap_content"
         android:layout_width="match_parent"
         android:layout_marginEnd="36dp"
         android:gravity="center"
         android:ellipsize="end"
         android:textSize="15sp"
         android:textColor="?attr/colorOnSurfaceVariant"
         android:singleLine="true"
         android:layout_marginTop="4dp"
         android:layout_marginStart="36dp"
         tools:text="Artist Name"
         android:id="@+id/musicSheetArtist" />

    <SeekBar
         android:layout_height="48dp"
         android:layout_width="match_parent"
         android:layout_marginEnd="20dp"
         android:thumb="@drawable/music_seekbar_thumb"
         android:layout_marginTop="16dp"
         android:layout_marginStart="20dp"
         tools:progress="50"
         android:maxHeight="48dp"
         android:contentDescription="@string/music_player_seekbar"
         android:minHeight="48dp"
         android:thumbTint="?attr/colorPrimary"
         android:progress="0"
         android:id="@+id/musicSheetSeekBar" />

    <LinearLayout
         android:layout_height="wrap_content"
         android:layout_width="match_parent"
         android:layout_marginEnd="36dp"
         android:orientation="horizontal"
         android:layout_marginStart="36dp">

        <TextView
             android:layout_height="wrap_content"
             android:layout_width="0dp"
             android:textSize="13sp"
             android:textColor="?attr/colorOnSurfaceVariant"
             tools:text="0:00"
             android:layout_weight="1"
             android:id="@+id/musicSheetPosition"
             android:textStyle="bold" />

        <TextView
             android:layout_height="wrap_content"
             android:layout_width="0dp"
             android:gravity="end"
             android:textSize="13sp"
             android:textColor="?attr/colorOnSurfaceVariant"
             tools:text="3:45"
             android:layout_weight="1"
             android:id="@+id/musicSheetDuration"
             android:textStyle="bold" />

    </LinearLayout>

    <LinearLayout
         android:layout_height="wrap_content"
         android:layout_width="match_parent"
         android:gravity="center"
         android:orientation="horizontal"
         android:layout_marginTop="8dp">

        <irhanzodev1375.musicpreview.ButtonAnim
             android:layout_height="64dp"
             android:layout_width="64dp"
             android:src="@drawable/icon_skip_previous_round"
             android:scaleType="centerInside"
             android:contentDescription="@string/music_preview_previous"
             android:padding="14dp"
             android:id="@+id/musicSheetPrev" />

        <irhanzodev1375.musicpreview.PlayerToggle
             android:layout_height="120dp"
             android:layout_width="120dp"
             android:layout_marginEnd="10dp"
             android:layout_marginStart="10dp"
             android:id="@+id/musicSheetPlayPause" />

        <irhanzodev1375.musicpreview.ButtonAnim
             android:layout_height="64dp"
             android:layout_width="64dp"
             android:src="@drawable/icon_skip_next_round"
             android:scaleType="centerInside"
             android:contentDescription="@string/music_preview_next"
             android:padding="14dp"
             android:id="@+id/musicSheetNext" />

    </LinearLayout>

</LinearLayout>
