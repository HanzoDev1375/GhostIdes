<?xml version="1.0" encoding="utf-8"?>
<org.appdevforall.codeonthego.layouteditor.editor.palette.layouts.LinearLayoutDesign
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical"
	android:gravity="center_horizontal">

	<org.appdevforall.codeonthego.layouteditor.editor.palette.layouts.LinearLayoutDesign
		android:id="@+id/rootmusic"
		android:layout_gravity="center"
		android:padding="8dp"
		android:gravity="center_vertical"
		android:orientation="horizontal"
		android:layout_height="match_parent"
		android:layout_width="match_parent">

		<org.appdevforall.codeonthego.layouteditor.editor.palette.widgets.ImageViewDesign
			android:id="@+id/musiccaver"
			android:layout_width="40dp"
			android:layout_height="40dp"
			android:layout_marginLeft="3dp"
			android:layout_marginRight="3dp"
			android:scaleType="centerInside"
			android:contentDescription="@string/music_preview_cover" />

		<org.appdevforall.codeonthego.layouteditor.editor.palette.text.TextViewDesign
			android:id="@+id/nameartist"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginLeft="3dp"
			android:layout_marginRight="3dp"
			android:padding="8dp"
			android:maxWidth="200dp"
			android:textSize="16sp"
			android:textColor="?colorOnSurface"
			android:singleLine="true"
			android:ellipsize="end"
			android:layout_weight="2" />

		<org.appdevforall.codeonthego.layouteditor.editor.palette.layouts.LinearLayoutDesign
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:gravity="center_vertical"
			android:orientation="horizontal">

			<org.appdevforall.codeonthego.layouteditor.editor.palette.widgets.ImageViewDesign
				android:id="@+id/previous"
				android:layout_width="40dp"
				android:layout_height="40dp"
				android:src="@drawable/icon_skip_previous_round"
				android:scaleType="centerInside"
				android:contentDescription="@string/music_preview_previous" />

			<org.appdevforall.codeonthego.layouteditor.editor.palette.widgets.ImageViewDesign
				android:id="@+id/play"
				android:layout_width="40dp"
				android:layout_height="40dp"
				android:src="@drawable/icon_play_arrow_round"
				android:scaleType="centerInside"
				android:contentDescription="@string/music_preview_play" />

			<org.appdevforall.codeonthego.layouteditor.editor.palette.widgets.ImageViewDesign
				android:id="@+id/next"
				android:layout_width="40dp"
				android:layout_height="40dp"
				android:src="@drawable/icon_skip_next_round"
				android:scaleType="centerInside"
				android:contentDescription="@string/music_preview_next" />

		</org.appdevforall.codeonthego.layouteditor.editor.palette.layouts.LinearLayoutDesign>

	</org.appdevforall.codeonthego.layouteditor.editor.palette.layouts.LinearLayoutDesign>

</org.appdevforall.codeonthego.layouteditor.editor.palette.layouts.LinearLayoutDesign>